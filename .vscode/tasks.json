{
  // For more information, visit: https://go.microsoft.com/fwlink/?LinkId=733558
  "version": "2.0.0",
  "tasks": [
    {
      "type": "npm",
      "script": "start",
      "label": "Run Angular app",
      "isBackground": true,
      "problemMatcher": {
        "owner": "typescript",
        "pattern": "$tsc",
        "background": {
          "activeOnStart": true,
          "beginsPattern": {
            "regexp": ".*"
          },
          "endsPattern": {
            "regexp": "Local:.*http://localhost:4200"
          }
        }
      }
    },
    {
      "type": "process",
      "command": "php",
      "args": ["-S", "127.0.0.1:8000", "-t", "backend/public", "backend/public/router.php"],
      "label": "Run PHP API",
      "isBackground": true,
      "problemMatcher": {
        "owner": "php",
        "pattern": {
          "regexp": "^$"
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": {
            "regexp": ".*"
          },
          "endsPattern": {
            "regexp": "Development Server \\(http://127\\.0\\.0\\.1:8000\\) started"
          }
        }
      }
    },
    {
      "label": "Run PHP API and Angular app",
      "dependsOn": ["Run PHP API", "Run Angular app"],
      "dependsOrder": "parallel",
      "problemMatcher": []
    },
    {
      "type": "npm",
      "script": "test",
      "isBackground": true,
      "problemMatcher": {
        "owner": "typescript",
        "pattern": "$tsc",
        "background": {
          "activeOnStart": true,
          "beginsPattern": {
            "regexp": "Changes detected"
          },
          "endsPattern": {
            "regexp": "bundle generation (complete|failed)"
          }
        }
      }
    }
  ]
}
